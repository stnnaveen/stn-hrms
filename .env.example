# Frontend (safe to expose; RLS protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave VITE_SUPABASE_URL empty to run in demo mode with sample data.

# Edge function secrets (set with: supabase secrets set KEY=value) — never in the frontend
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_SELFIE_BUCKET=stn-hr-selfies
# GOOGLE_GEOCODING_KEY=...   (or MAPPLS_KEY)
