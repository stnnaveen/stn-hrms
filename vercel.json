{
  "rewrites": [{ "source": "/((?!assets/|icons/|sw.js|workbox-|manifest.webmanifest).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(index.html|manifest.webmanifest|registerSW.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self)" }] }
  ]
}
